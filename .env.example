# Database (SQLite for local/sandbox dev — swap provider to "postgresql" in
# prisma/schema.prisma and point this at a Postgres connection string for
# production; no model changes are required).
DATABASE_URL="file:./dev.db"

# Auth
JWT_SECRET="replace-with-a-long-random-secret-in-production"
JWT_EXPIRES_IN="7d"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
